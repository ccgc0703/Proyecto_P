# Copia este archivo como `.env` en la raíz del proyecto y ajusta los valores.
# `.env` está en .gitignore: nunca se commitea.

# ── Base de datos (PostgreSQL) ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/poseidon

# ── Seguridad ──────────────────────────────────────────────────────────────
# Obligatorio: sin él el servicio NO arranca (se valida en src/main.ts).
# Debe tener 32+ caracteres. Genera uno con:  openssl rand -base64 48
JWT_SECRET=genera-aqui-una-clave-aleatoria-de-32-o-mas-caracteres

# ── Opcionales (valor por defecto entre paréntesis) ────────────────────────
# PORT=3000
# RATE_LIMIT_GLOBAL=600          # peticiones/min por IP (subir solo para pruebas de carga)
# AUDIT_RETENTION_DAYS=365       # retención del log de auditoría; <=0 desactiva la poda
