generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Genero {
  MASCULINO
  FEMENINO
}

enum TipoMiembro {
  JOVEN
  ADULTO
}

enum EstadoMiembro {
  ACTIVO
  INACTIVO
  EGRESADO
}

enum TipoProgramaMundial {
  PROGRAMA_MUNDIAL
  DESAFIO
  INICIATIVA
}

enum EstadoProgramaMundial {
  PENDIENTE
  EN_CURSO
  COMPLETADO
}

enum EstadoPlanificacion {
  BORRADOR
  APROBADO
  EN_CURSO
  COMPLETADO
  CANCELADO
}

enum TipoActividad {
  REUNION
  CAMPAMENTO
  EXCURSION
  SERVICIO_COMUNITARIO
  TALLER
  CEREMONIA
  COMPETENCIA
  OTRO
}

enum EstadoActividad {
  PENDIENTE
  EN_CURSO
  COMPLETADA
  CANCELADA
}

enum TipoSangre {
  A_POSITIVO
  A_NEGATIVO
  B_POSITIVO
  B_NEGATIVO
  AB_POSITIVO
  AB_NEGATIVO
  O_POSITIVO
  O_NEGATIVO
  DESCONOCIDO
}

enum Severidad {
  LEVE
  MODERADA
  SEVERA
}

// ─── Progresión personal de jóvenes ───────────────────────────────────────

enum EstadoLogro {
  PENDIENTE
  EN_PROCESO
  PENDIENTE_APROBACION
  COMPLETADO
}

enum EstadoProgresion {
  EN_CURSO
  SOLICITADA
  APROBADA
  RECHAZADA
}

enum TipoArea {
  AREA_CRECIMIENTO
  PRUEBA_ADELANTO
}

// Rama del catálogo de progresión (nacional, compartido por todos los grupos)
enum RamaUnidad {
  MANADA
  TROPA
  COMUNIDAD
  CLAN
}

// ─────────────────────────────────────────────
// Modelos Base: Usuario, Unidad y Organización
// ─────────────────────────────────────────────

/// Nivel jerárquico del árbol organizacional (1 = cúspide).
/// No confundir con los niveles RBAC (ROLE_HIERARCHY).
enum TipoNodoOrganizacion {
  CONSEJO_NACIONAL
  DIRECCION_EJECUTIVA
  REGION
  DISTRITO
  GRUPO
}

model OrganizacionNodo {
  id        String               @id @default(uuid())
  codigo    String               @unique // Autogenerado: CON-01, DIR-01, REG-01, DIS-01, GRP-01
  nombre    String
  tipo      TipoNodoOrganizacion
  nivel     Int // 1 Consejo, 2 Dirección, 3 Región, 4 Distrito, 5 Grupo
  padreId   String?
  activo    Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  padre    OrganizacionNodo?  @relation("NodoJerarquia", fields: [padreId], references: [id])
  hijos    OrganizacionNodo[] @relation("NodoJerarquia")
  Unidades Unidad[]
  Usuarios Usuario[]
  Cargos   CargoAsignacion[]

  @@index([padreId])
  @@index([tipo])
  @@index([padreId, activo])
}

// ─────────────────────────────────────────────
// Cargos: quién ocupa qué cargo en cada nodo
// ─────────────────────────────────────────────

model CargoAsignacion {
  id        String    @id @default(uuid())
  usuarioId String
  nodoId    String
  cargo     String // Canónico: JEFE_GRUPO, COMISIONADO_REGIONAL, DIR_EJECUTIVO...
  desde     DateTime  @default(now())
  hasta     DateTime? // Cierre (renombrado/desplazado); null = vigente
  activo    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  Usuario Usuario          @relation(fields: [usuarioId], references: [id])
  Nodo    OrganizacionNodo @relation(fields: [nodoId], references: [id])

  @@index([nodoId])
  @@index([usuarioId])
}

model Usuario {
  id           String    @id @default(uuid())
  nombre       String
  apellido     String?
  email        String    @unique
  password     String
  fotoUrl      String?
  unidadId     String?
  nodoId       String? // Ámbito del líder (región/distrito/grupo/nacional)
  activo       Boolean   @default(true)
  tokenVersion Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdBy    String?
  updatedBy    String?

  Unidad            Unidad?             @relation(fields: [unidadId], references: [id])
  Nodo              OrganizacionNodo?   @relation(fields: [nodoId], references: [id])
  CargoAsignaciones CargoAsignacion[]
  AuditLogs         BitacoraAuditoria[]
  AuditLogEntries   AuditLog[]          @relation("AuditLogActor")
  UsuarioRoles      UsuarioRol[]
  Adulto            Adulto?
  Joven             Joven?

  @@index([unidadId])
  @@index([nodoId])
  @@index([deletedAt])
}

model Unidad {
  id          String    @id @default(uuid())
  nombre      String // Manada, Tropa, Comunidad, Clan
  tipo        String?
  descripcion String?
  grupoId     String? // Nodo GRUPO al que pertenece
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?

  Grupo           OrganizacionNodo? @relation(fields: [grupoId], references: [id])
  Usuarios        Usuario[]
  Miembros        Miembro[]
  Patrullas       Patrulla[]
  Planificaciones Planificacion[]

  @@unique([grupoId, tipo]) // Una instancia de rama por grupo
  @@index([grupoId])
}

// ─────────────────────────────────────────────
// Core Scout: Miembro, Joven, Adulto
// ─────────────────────────────────────────────

model Miembro {
  id              String        @id @default(uuid())
  nombres         String
  apellidos       String
  cedula          String        @unique
  fechaNacimiento DateTime
  genero          Genero
  tipo            TipoMiembro
  estado          EstadoMiembro @default(ACTIVO)
  unidadId        String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  createdBy       String?
  updatedBy       String?

  Unidad             Unidad                   @relation(fields: [unidadId], references: [id])
  Joven              Joven?
  Adulto             Adulto?
  DatosScout         DatosScout?
  FichaMedica        FichaMedica?
  Condecoraciones    MiembroCondecoracion[]
  ProgramasMundiales MiembroProgramaMundial[]

  @@index([tipo, deletedAt])
  @@index([unidadId, tipo, deletedAt])
  @@index([deletedAt])
  @@index([apellidos, nombres])
}

model Joven {
  id              String  @id @default(uuid())
  miembroId       String  @unique
  usuarioId       String? @unique
  representanteId String
  historial       String?

  Miembro       Miembro            @relation(fields: [miembroId], references: [id])
  Usuario       Usuario?           @relation(fields: [usuarioId], references: [id])
  Representante Representante      @relation(fields: [representanteId], references: [id])
  Progresiones  Progresion[]
  EstadosLogro  EstadoLogroJoven[]

  @@index([representanteId])
}

model Adulto {
  id        String  @id @default(uuid())
  miembroId String  @unique
  usuarioId String? @unique
  ocupacion String?
  telefono  String?
  direccion String?

  Miembro     Miembro     @relation(fields: [miembroId], references: [id])
  Usuario     Usuario?    @relation(fields: [usuarioId], references: [id])
  Formaciones Formacion[]
}

model Representante {
  id         String    @id @default(uuid())
  nombre     String
  cedula     String    @unique
  telefono   String?
  direccion  String?
  parentesco String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  createdBy  String?
  updatedBy  String?

  Jovenes Joven[]
}

// ─────────────────────────────────────────────
// Extensiones de Miembro
// ─────────────────────────────────────────────

model DatosScout {
  id            String    @id @default(uuid())
  miembroId     String    @unique
  fechaRegistro DateTime?
  fechaIngreso  DateTime?
  fechaPromesa  DateTime?
  cargoActual   String?
  observaciones String?
  patrullaId    String?

  Miembro  Miembro   @relation(fields: [miembroId], references: [id])
  Patrulla Patrulla? @relation(fields: [patrullaId], references: [id])

  @@index([patrullaId])
}

model FichaMedica {
  id                           String      @id @default(uuid())
  // Datos generales del miembro
  tipoSangre                   TipoSangre?
  telefono                     String?
  email                        String?
  // Datos médicos individuales
  medicoTratante               String?
  telefonoMedico               String?
  // Seguro médico
  seguroCompania               String?
  seguroPoliza                 String?
  seguroVigencia               DateTime?
  // Contacto de emergencia (desglosado)
  contactoEmergenciaNombre     String?
  contactoEmergenciaTelefono   String?
  contactoEmergenciaParentesco String?
  // Texto libre resumen (opcional — el detalle vive en tablas hijas)
  alergias                     String?
  medicamentos                 String?
  condiciones                  String?
  observaciones                String?
  // Consentimiento / autorización médica
  consentimiento               Boolean?    @default(false)
  consentimientoFecha          DateTime?
  consentimientoObservaciones  String?

  miembroId String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  Miembro      Miembro                  @relation(fields: [miembroId], references: [id])
  Alergias     AlergiaFichaMedica[]
  Medicamentos MedicamentoFichaMedica[]
  Condiciones  CondicionFichaMedica[]
  Vacunas      VacunaFichaMedica[]
}

model AlergiaFichaMedica {
  id            String    @id @default(uuid())
  fichaMedicaId String
  nombre        String
  severidad     Severidad @default(LEVE)
  reaccion      String?
  observaciones String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?

  FichaMedica FichaMedica @relation(fields: [fichaMedicaId], references: [id])

  @@index([fichaMedicaId])
}

model MedicamentoFichaMedica {
  id            String    @id @default(uuid())
  fichaMedicaId String
  nombre        String
  dosis         String?
  frecuencia    String?
  motivo        String?
  prescritoPor  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?

  FichaMedica FichaMedica @relation(fields: [fichaMedicaId], references: [id])

  @@index([fichaMedicaId])
}

model CondicionFichaMedica {
  id               String    @id @default(uuid())
  fichaMedicaId    String
  nombre           String
  descripcion      String?
  fechaDiagnostico DateTime?
  requiereControl  Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  createdBy        String?
  updatedBy        String?

  FichaMedica FichaMedica @relation(fields: [fichaMedicaId], references: [id])

  @@index([fichaMedicaId])
}

model VacunaFichaMedica {
  id              String    @id @default(uuid())
  fichaMedicaId   String
  nombre          String
  fechaAplicacion DateTime?
  lote            String?
  observaciones   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  createdBy       String?
  updatedBy       String?

  FichaMedica FichaMedica @relation(fields: [fichaMedicaId], references: [id])

  @@index([fichaMedicaId])
}

model Formacion {
  id        String    @id @default(uuid())
  nombre    String
  fecha     DateTime
  director  String
  adultoId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  Adulto Adulto @relation(fields: [adultoId], references: [id])

  @@index([adultoId])
}

model Condecoracion {
  id          String    @id @default(uuid())
  nombre      String
  tipo        String
  descripcion String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?

  Miembros MiembroCondecoracion[]
}

model MiembroCondecoracion {
  id              String    @id @default(uuid())
  miembroId       String
  condecoracionId String
  fechaOtorgada   DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  createdBy       String?
  updatedBy       String?

  Miembro       Miembro       @relation(fields: [miembroId], references: [id])
  Condecoracion Condecoracion @relation(fields: [condecoracionId], references: [id])

  @@unique([miembroId, condecoracionId])
}

// ─────────────────────────────────────────────
// Progresión personal de jóvenes
// ─────────────────────────────────────────────

model AreaCrecimiento {
  id        String      @id @default(uuid())
  nombre    String      @unique
  tipo      TipoArea    @default(AREA_CRECIMIENTO)
  orden     Int
  activo    Boolean     @default(true)
  rama      RamaUnidad? // null = aplica a todas las ramas
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  Indicadores IndicadorLogro[]
}

model Etapa {
  id        String     @id @default(uuid())
  numero    Int        @unique
  nombre    String
  rama      RamaUnidad
  activo    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  Indicadores IndicadorLogro[]
}

model IndicadorLogro {
  id        String     @id @default(uuid())
  codigo    String
  texto     String
  etapaId   String
  areaId    String
  rama      RamaUnidad
  orden     Int
  activo    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  Etapa   Etapa              @relation(fields: [etapaId], references: [id])
  Area    AreaCrecimiento    @relation(fields: [areaId], references: [id])
  Estados EstadoLogroJoven[]

  @@unique([etapaId, areaId, codigo])
  @@index([etapaId])
  @@index([areaId])
  @@index([rama])
}

model Adelanto {
  id               String     @id @default(uuid())
  rama             RamaUnidad
  orden            Int
  nombre           String
  edadMinima       Int?
  umbralPorcentaje Int?
  activo           Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?
  createdBy        String?
  updatedBy        String?

  Progresiones Progresion[]

  @@unique([rama, orden])
}

model Progresion {
  id               String           @id @default(uuid())
  jovenId          String
  adelantoId       String
  fechaInicio      DateTime         @default(now())
  fechaCulminacion DateTime?
  estado           EstadoProgresion @default(EN_CURSO)
  aprobadoPor      String?
  aprobadoEn       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  createdBy        String?
  updatedBy        String?

  Joven    Joven    @relation(fields: [jovenId], references: [id])
  Adelanto Adelanto @relation(fields: [adelantoId], references: [id])

  @@unique([jovenId, adelantoId])
  @@index([jovenId])
  @@index([jovenId, estado])
}

model EstadoLogroJoven {
  id            String      @id @default(uuid())
  jovenId       String
  indicadorId   String
  estado        EstadoLogro @default(PENDIENTE)
  observaciones String?
  registradoPor String?
  registradoEn  DateTime    @default(now())
  aprobadoPor   String?
  aprobadoEn    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?

  Joven     Joven          @relation(fields: [jovenId], references: [id])
  Indicador IndicadorLogro @relation(fields: [indicadorId], references: [id])

  @@unique([jovenId, indicadorId])
  @@index([jovenId])
  @@index([jovenId, estado])
}

model ProgramaMundial {
  id          String              @id @default(uuid())
  nombre      String
  tipo        TipoProgramaMundial
  descripcion String?
  activo      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  Miembros MiembroProgramaMundial[]
}

model MiembroProgramaMundial {
  id                String                @id @default(uuid())
  miembroId         String
  programaMundialId String
  fechaInicio       DateTime
  fechaCompletado   DateTime?
  estado            EstadoProgramaMundial @default(PENDIENTE)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?

  Miembro         Miembro         @relation(fields: [miembroId], references: [id])
  ProgramaMundial ProgramaMundial @relation(fields: [programaMundialId], references: [id])

  @@unique([miembroId, programaMundialId])
}

// ─────────────────────────────────────────────
// Auditoría
// ─────────────────────────────────────────────

model BitacoraAuditoria {
  id           String    @id @default(uuid())
  usuarioId    String?
  accion       String
  tabla        String
  registroId   String
  datosAntes   Json?
  datosDespues Json?
  ip           String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdBy    String?
  updatedBy    String?

  Usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([tabla, registroId])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  action      String
  module      String
  targetId    String?
  description String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor Usuario? @relation("AuditLogActor", fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([module, action])
  @@index([actorId])
}

// ─────────────────────────────────────────────
// RBAC — Role-Based Access Control
// ─────────────────────────────────────────────

model Rol {
  id          String    @id @default(uuid())
  nombre      String    @unique // SYSTEM_ADMIN, GROUP_LEADER, etc.
  descripcion String?
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   String?

  UsuarioRoles UsuarioRol[]
  RolPermisos  RolPermiso[]
}

model Permiso {
  id          String   @id @default(uuid())
  accion      String   @unique // "user:create", "joven:view", "rbac:manage"
  modulo      String // "users", "jovenes", "rbac"
  descripcion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  RolPermisos RolPermiso[]
}

model UsuarioRol {
  id          String    @id @default(uuid())
  usuarioId   String
  rolId       String
  asignadoPor String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  Usuario Usuario @relation(fields: [usuarioId], references: [id])
  Rol     Rol     @relation(fields: [rolId], references: [id])

  @@unique([usuarioId, rolId])
  @@index([usuarioId])
}

model RolPermiso {
  id        String    @id @default(uuid())
  rolId     String
  permisoId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  Rol     Rol     @relation(fields: [rolId], references: [id])
  Permiso Permiso @relation(fields: [permisoId], references: [id])

  @@unique([rolId, permisoId])
  @@index([rolId])
}

model AuditRBAC {
  id             String   @id @default(uuid())
  accion         String
  entidad        String
  entidadId      String
  realizadoPorId String?
  datosCambio    Json?
  ip             String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Patrullas / Seisenas
// ─────────────────────────────────────────────

model Patrulla {
  id        String    @id @default(uuid())
  nombre    String
  unidadId  String
  color     String?
  activa    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?

  Unidad   Unidad       @relation(fields: [unidadId], references: [id])
  Miembros DatosScout[]

  @@index([unidadId])
}

// ─────────────────────────────────────────────
// Planificación y Actividades
// ─────────────────────────────────────────────

model Planificacion {
  id          String              @id @default(uuid())
  titulo      String
  descripcion String?
  fechaInicio DateTime
  fechaFin    DateTime
  unidadId    String?
  estado      EstadoPlanificacion @default(BORRADOR)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?

  Unidad      Unidad?     @relation(fields: [unidadId], references: [id])
  Actividades Actividad[]

  @@index([unidadId])
}

model Actividad {
  id              String          @id @default(uuid())
  titulo          String
  descripcion     String?
  tipo            TipoActividad   @default(REUNION)
  fecha           DateTime
  horaInicio      String?
  horaFin         String?
  lugar           String?
  responsable     String?
  planificacionId String
  estado          EstadoActividad @default(PENDIENTE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  createdBy       String?

  Planificacion Planificacion @relation(fields: [planificacionId], references: [id])

  @@index([planificacionId])
  @@index([fecha])
}
