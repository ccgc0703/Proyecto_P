generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Genero {
  MASCULINO
  FEMENINO
}

enum TipoMiembro {
  JOVEN
  ADULTO
}

enum EstadoMiembro {
  ACTIVO
  INACTIVO
  EGRESADO
}

enum TipoProgramaMundial {
  PROGRAMA_MUNDIAL
  DESAFIO
  INICIATIVA
}

enum EstadoProgramaMundial {
  PENDIENTE
  EN_CURSO
  COMPLETADO
}

enum EstadoPlanificacion {
  BORRADOR
  APROBADO
  EN_CURSO
  COMPLETADO
  CANCELADO
}

enum TipoActividad {
  REUNION
  CAMPAMENTO
  EXCURSION
  SERVICIO_COMUNITARIO
  TALLER
  CEREMONIA
  COMPETENCIA
  OTRO
}

enum EstadoActividad {
  PENDIENTE
  EN_CURSO
  COMPLETADA
  CANCELADA
}

enum TipoSangre {
  A_POSITIVO
  A_NEGATIVO
  B_POSITIVO
  B_NEGATIVO
  AB_POSITIVO
  AB_NEGATIVO
  O_POSITIVO
  O_NEGATIVO
  DESCONOCIDO
}

enum Severidad {
  LEVE
  MODERADA
  SEVERA
}

// ─────────────────────────────────────────────
// Modelos Base: Usuario y Unidad
// ─────────────────────────────────────────────

model Usuario {
  id           String    @id @default(uuid())
  nombre       String
  apellido     String?
  email        String    @unique
  password     String
  fotoUrl      String?
  unidadId     String?
  activo       Boolean   @default(true)
  tokenVersion Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdBy    String?
  updatedBy    String?

  Unidad          Unidad?              @relation(fields: [unidadId], references: [id])
  AuditLogs       BitacoraAuditoria[]
  AuditLogEntries AuditLog[]           @relation("AuditLogActor")
  UsuarioRoles    UsuarioRol[]
  Adulto          Adulto?
}

model Unidad {
  id          String    @id @default(uuid())
  nombre      String    // Manada, Tropa, Clan
  tipo        String?
  descripcion String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?

  Usuarios        Usuario[]
  Miembros        Miembro[]
  Progresiones    Progresion[]
  Patrullas       Patrulla[]
  Planificaciones Planificacion[]
}

// ─────────────────────────────────────────────
// Core Scout: Miembro, Joven, Adulto
// ─────────────────────────────────────────────

model Miembro {
  id              String         @id @default(uuid())
  nombres         String
  apellidos       String
  cedula          String         @unique
  fechaNacimiento DateTime
  genero          Genero
  tipo            TipoMiembro
  estado          EstadoMiembro  @default(ACTIVO)
  unidadId        String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  createdBy       String?
  updatedBy       String?

  Unidad              Unidad                   @relation(fields: [unidadId], references: [id])
  Joven               Joven?
  Adulto              Adulto?
  DatosScout          DatosScout?
  FichaMedica         FichaMedica?
  Condecoraciones     MiembroCondecoracion[]
  ProgramasMundiales  MiembroProgramaMundial[]
}

model Joven {
  id              String    @id @default(uuid())
  miembroId       String    @unique
  representanteId String
  historial       String?

  Miembro       Miembro       @relation(fields: [miembroId], references: [id])
  Representante Representante @relation(fields: [representanteId], references: [id])
  Progresiones  Progresion[]
}

model Adulto {
  id        String  @id @default(uuid())
  miembroId String  @unique
  usuarioId String? @unique
  ocupacion String?
  telefono  String?
  direccion String?

  Miembro     Miembro     @relation(fields: [miembroId], references: [id])
  Usuario     Usuario?    @relation(fields: [usuarioId], references: [id])
  Formaciones Formacion[]
}

model Representante {
  id          String    @id @default(uuid())
  nombre      String
  cedula      String    @unique
  telefono    String?
  direccion   String?
  parentesco  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?

  Jovenes     Joven[]
}

// ─────────────────────────────────────────────
// Extensiones de Miembro
// ─────────────────────────────────────────────

model DatosScout {
  id             String    @id @default(uuid())
  miembroId      String    @unique
  fechaRegistro  DateTime?
  fechaIngreso   DateTime?
  fechaPromesa   DateTime?
  cargoActual    String?
  observaciones  String?
  patrullaId     String?

  Miembro  Miembro   @relation(fields: [miembroId], references: [id])
  Patrulla Patrulla? @relation(fields: [patrullaId], references: [id])
}

model FichaMedica {
  id                               String    @id @default(uuid())
  // Datos generales del miembro
  tipoSangre                       TipoSangre?
  telefono                         String?
  email                            String?
  // Datos médicos individuales
  medicoTratante                   String?
  telefonoMedico                   String?
  // Seguro médico
  seguroCompania                   String?
  seguroPoliza                     String?
  seguroVigencia                   DateTime?
  // Contacto de emergencia (desglosado)
  contactoEmergenciaNombre         String?
  contactoEmergenciaTelefono       String?
  contactoEmergenciaParentesco     String?
  // Texto libre resumen (opcional — el detalle vive en tablas hijas)
  alergias                         String?
  medicamentos                     String?
  condiciones                      String?
  observaciones                    String?
  // Consentimiento / autorización médica
  consentimiento                   Boolean?  @default(false)
  consentimientoFecha              DateTime?
  consentimientoObservaciones      String?

  miembroId                        String    @unique
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt
  deletedAt                        DateTime?
  createdBy                        String?
  updatedBy                        String?

  Miembro                          Miembro                 @relation(fields: [miembroId], references: [id])
  Alergias                         AlergiaFichaMedica[]
  Medicamentos                     MedicamentoFichaMedica[]
  Condiciones                      CondicionFichaMedica[]
  Vacunas                          VacunaFichaMedica[]
}

model AlergiaFichaMedica {
  id            String    @id @default(uuid())
  fichaMedicaId String
  nombre        String
  severidad     Severidad @default(LEVE)
  reaccion      String?
  observaciones String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?

  FichaMedica   FichaMedica @relation(fields: [fichaMedicaId], references: [id])

  @@index([fichaMedicaId])
}

model MedicamentoFichaMedica {
  id            String    @id @default(uuid())
  fichaMedicaId String
  nombre        String
  dosis         String?
  frecuencia    String?
  motivo        String?
  prescritoPor  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?

  FichaMedica   FichaMedica @relation(fields: [fichaMedicaId], references: [id])

  @@index([fichaMedicaId])
}

model CondicionFichaMedica {
  id               String    @id @default(uuid())
  fichaMedicaId    String
  nombre           String
  descripcion      String?
  fechaDiagnostico DateTime?
  requiereControl  Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  createdBy        String?
  updatedBy        String?

  FichaMedica      FichaMedica @relation(fields: [fichaMedicaId], references: [id])

  @@index([fichaMedicaId])
}

model VacunaFichaMedica {
  id               String    @id @default(uuid())
  fichaMedicaId    String
  nombre           String
  fechaAplicacion  DateTime?
  lote             String?
  observaciones    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  createdBy        String?
  updatedBy        String?

  FichaMedica      FichaMedica @relation(fields: [fichaMedicaId], references: [id])

  @@index([fichaMedicaId])
}

model Formacion {
  id        String   @id @default(uuid())
  nombre    String   
  fecha     DateTime 
  director  String   
  adultoId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  Adulto    Adulto   @relation(fields: [adultoId], references: [id])
}

model Condecoracion {
  id          String    @id @default(uuid())
  nombre      String
  tipo        String
  descripcion String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?

  Miembros    MiembroCondecoracion[]
}

model MiembroCondecoracion {
  id              String    @id @default(uuid())
  miembroId       String
  condecoracionId String
  fechaOtorgada   DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  createdBy       String?
  updatedBy       String?

  Miembro         Miembro       @relation(fields: [miembroId], references: [id])
  Condecoracion   Condecoracion @relation(fields: [condecoracionId], references: [id])

  @@unique([miembroId, condecoracionId])
}

model Progresion {
  id               String    @id @default(uuid())
  etapa            String
  fechaInicio      DateTime  @default(now())
  fechaCulminacion DateTime?
  unidadId         String
  jovenId          String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  createdBy        String?
  updatedBy        String?

  Unidad           Unidad    @relation(fields: [unidadId], references: [id])
  Joven            Joven     @relation(fields: [jovenId], references: [id])
}

model ProgramaMundial {
  id          String              @id @default(uuid())
  nombre      String
  tipo        TipoProgramaMundial
  descripcion String?
  activo      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  Miembros    MiembroProgramaMundial[]
}

model MiembroProgramaMundial {
  id                String                @id @default(uuid())
  miembroId         String
  programaMundialId String
  fechaInicio       DateTime
  fechaCompletado   DateTime?
  estado            EstadoProgramaMundial @default(PENDIENTE)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?

  Miembro         Miembro         @relation(fields: [miembroId], references: [id])
  ProgramaMundial ProgramaMundial @relation(fields: [programaMundialId], references: [id])

  @@unique([miembroId, programaMundialId])
}

// ─────────────────────────────────────────────
// Auditoría
// ─────────────────────────────────────────────

model BitacoraAuditoria {
  id            String    @id @default(uuid())
  usuarioId     String?
  accion        String
  tabla         String
  registroId    String
  datosAntes    Json?
  datosDespues  Json?
  ip            String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?

  Usuario       Usuario?  @relation(fields: [usuarioId], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  action      String
  module      String
  targetId    String?
  description String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor       Usuario? @relation("AuditLogActor", fields: [actorId], references: [id])
}

// ─────────────────────────────────────────────
// RBAC — Role-Based Access Control
// ─────────────────────────────────────────────

model Rol {
  id          String    @id @default(uuid())
  nombre      String    @unique  // SYSTEM_ADMIN, GROUP_LEADER, etc.
  descripcion String?
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   String?

  UsuarioRoles UsuarioRol[]
  RolPermisos  RolPermiso[]
}

model Permiso {
  id          String    @id @default(uuid())
  accion      String    @unique  // "user:create", "joven:view", "rbac:manage"
  modulo      String             // "users", "jovenes", "rbac"
  descripcion String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  RolPermisos RolPermiso[]
}

model UsuarioRol {
  id          String    @id @default(uuid())
  usuarioId   String
  rolId       String
  asignadoPor String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  Usuario     Usuario   @relation(fields: [usuarioId], references: [id])
  Rol         Rol       @relation(fields: [rolId], references: [id])

  @@unique([usuarioId, rolId])
  @@index([usuarioId])
}

model RolPermiso {
  id          String    @id @default(uuid())
  rolId       String
  permisoId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  Rol         Rol       @relation(fields: [rolId], references: [id])
  Permiso     Permiso   @relation(fields: [permisoId], references: [id])

  @@unique([rolId, permisoId])
  @@index([rolId])
}

model AuditRBAC {
  id              String    @id @default(uuid())
  accion          String
  entidad         String
  entidadId       String
  realizadoPorId  String?
  datosCambio     Json?
  ip              String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ─────────────────────────────────────────────
// Patrullas / Seisenas
// ─────────────────────────────────────────────

model Patrulla {
  id          String    @id @default(uuid())
  nombre      String
  unidadId    String
  color       String?
  activa      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   String?

  Unidad      Unidad    @relation(fields: [unidadId], references: [id])
  Miembros    DatosScout[]

  @@index([unidadId])
}

// ─────────────────────────────────────────────
// Planificación y Actividades
// ─────────────────────────────────────────────

model Planificacion {
  id          String    @id @default(uuid())
  titulo      String
  descripcion String?
  fechaInicio DateTime
  fechaFin    DateTime
  unidadId    String?
  estado      EstadoPlanificacion @default(BORRADOR)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?

  Unidad      Unidad?   @relation(fields: [unidadId], references: [id])
  Actividades Actividad[]
}

model Actividad {
  id              String    @id @default(uuid())
  titulo          String
  descripcion     String?
  tipo            TipoActividad @default(REUNION)
  fecha           DateTime
  horaInicio      String?
  horaFin         String?
  lugar           String?
  responsable     String?
  planificacionId String
  estado          EstadoActividad @default(PENDIENTE)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  createdBy       String?

  Planificacion   Planificacion @relation(fields: [planificacionId], references: [id])

  @@index([planificacionId])
  @@index([fecha])
}
